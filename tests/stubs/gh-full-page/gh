#!/bin/sh
# stub: the repo-wide open-PR listing comes back exactly full, which is what a
# truncated page looks like from the inside. Per-branch --head calls return [].
prev=""; head=""; limit=""
for a in "$@"; do
  [ "$prev" = "--head" ] && head="$a"
  [ "$prev" = "--limit" ] && limit="$a"
  prev="$a"
done
if [ -n "$head" ]; then echo '[]'; exit 0; fi
i=1
printf '['
while [ "$i" -le "$limit" ]; do
  [ "$i" -gt 1 ] && printf ','
  printf '{"headRefName":"filler-%s","updatedAt":"2026-08-27T10:00:00Z"}' "$i"
  i=$((i + 1))
done
printf ']\n'
